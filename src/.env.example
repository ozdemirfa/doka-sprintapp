# ============================================================
# Sprint Kanban — Ortam Değişkenleri
# Kopyala: cp .env.example .env
# .env dosyasını GIT'E EKLEME — .gitignore'da kayıtlı
# ============================================================

# Supabase Proje URL'i
# Supabase Dashboard → Project Settings → API → Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonim (Public) Anahtar
# Tarayıcıda güvenli kullanılabilir — RLS politikaları erişimi kısıtlar
# Supabase Dashboard → Project Settings → API → anon public
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Anahtarı
# ⚠️ TARAYICIDA ASLA KULLANMA — sadece SQL migration / seed script'leri için
# Supabase Dashboard → Project Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
